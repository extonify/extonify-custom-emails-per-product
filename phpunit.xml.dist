<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
		 bootstrap="tests/bootstrap.php"
		 colors="true"
		 beStrictAboutOutputDuringTests="true"
		 failOnWarning="true"
		 failOnRisky="true"
		 convertErrorsToExceptions="true"
		 convertNoticesToExceptions="true"
		 convertWarningsToExceptions="true"
		 convertDeprecationsToExceptions="false"
		 cacheResultFile=".phpunit.result.cache">
	<testsuites>
		<!-- Pure logic. No WordPress, no database: these must pass with the
		     WordPress bootstrap switched off entirely. -->
		<testsuite name="unit">
			<directory suffix="Test.php">tests/Unit</directory>
		</testsuite>
		<!-- Boots the live WordPress + WooCommerce runtime the same way
		     poc/_bootstrap.php does, against the real database. Every test
		     creates and destroys its own fixtures and verifies teardown. -->
		<testsuite name="integration">
			<directory suffix="Test.php">tests/Integration</directory>
		</testsuite>
	</testsuites>
</phpunit>

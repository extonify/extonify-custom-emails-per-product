# Excluded from the distributed release archive.
#
# Everything listed here is development-only or regenerable. The shipped zip
# contains the plugin bootstrap, src/, assets/, uninstall.php, languages/,
# readme.txt, composer.json and the production vendor/ autoloader — nothing else.
/.git
/.github
/docs
/poc
/tests
/node_modules
/dist
/bin
.gitignore
.distignore
# composer.json IS shipped. The Plugin Review Team's "Using composer but no
# composer.json file" note asks for it even when it is only used for development,
# so others can review, study and fork the build. composer.lock stays out, and
# --no-dev keeps require-dev packages out of vendor/.
composer.lock
phpcs.xml.dist
phpunit.xml.dist
package.json
package-lock.json
.phpunit.result.cache
.DS_Store
# All Markdown is development documentation. readme.txt (not .md) is the
# WordPress.org-required file and is NOT excluded.
*.md
